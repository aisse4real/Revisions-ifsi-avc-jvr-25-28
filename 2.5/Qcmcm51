let currentIndex = 0;
let userAnswers = {};
let reviewMode = false;
let displayedQuestions = [...questions];

function init() {
    renderGrid();
    loadQuestion(currentIndex);
    updateStats();
}

function getErrorQuestions() {
    return questions.filter(q => {
        const userAns = userAnswers[q.id];
        if (!userAns) return false;
        const sortedUser = [...userAns].sort().join(',');
        const sortedCorr = [...q.correct].sort().join(',');
        return sortedUser !== sortedCorr;
    });
}

function renderGrid() {
    const grid = document.getElementById('question-grid');
    grid.innerHTML = '';
    displayedQuestions.forEach((q, idx) => {
        const item = document.createElement('div');
        item.className = 'grid-item';
        item.textContent = q.id;
        if (idx === currentIndex) item.classList.add('active');

        if (userAnswers[q.id]) {
            const sortedUser = [...userAnswers[q.id]].sort().join(',');
            const sortedCorr = [...q.correct].sort().join(',');
            if (sortedUser === sortedCorr) {
                item.classList.add('correct');
            } else {
                item.classList.add('incorrect');
            }
        }

        item.onclick = () => {
            currentIndex = idx;
            loadQuestion(currentIndex);
        };
        grid.appendChild(item);
    });
}

function loadQuestion(index) {
    if (displayedQuestions.length === 0) {
        document.getElementById('q-label').textContent = "Terminé";
        document.getElementById('q-text').textContent = "Aucune erreur enregistrée ! Toutes vos réponses sont exactes.";
        document.getElementById('options-container').innerHTML = '';
        document.getElementById('feedback').style.display = 'none';
        document.getElementById('validate-btn').disabled = true;
        return;
    }

    const q = displayedQuestions[index];
    document.getElementById('q-label').textContent = `Question ${q.id} sur 40 ${reviewMode ? '(Mode Erreurs)' : ''}`;
    document.getElementById('q-text').textContent = q.question;

    const optContainer = document.getElementById('options-container');
    optContainer.innerHTML = '';

    const letters = ['A', 'B', 'C', 'D'];
    const currentSelections = userAnswers[q.id] || [];
    const isAnswered = userAnswers[q.id] !== undefined;

    q.options.forEach((optText, optIdx) => {
        const optDiv = document.createElement('div');
        optDiv.className = 'option-item';
        if (currentSelections.includes(optIdx)) optDiv.classList.add('selected');

        const chk = document.createElement('input');
        chk.type = 'checkbox';
        chk.checked = currentSelections.includes(optIdx);

        const label = document.createElement('span');
        label.innerHTML = `<span class="opt-letter">${letters[optIdx]}.</span> ${optText}`;

        optDiv.appendChild(chk);
        optDiv.appendChild(label);

        if (!isAnswered) {
            optDiv.onclick = () => {
                chk.checked = !chk.checked;
                if (chk.checked) {
                    optDiv.classList.add('selected');
                } else {
                    optDiv.classList.remove('selected');
                }
            };
        } else {
            optDiv.style.cursor = 'default';
        }

        optContainer.appendChild(optDiv);
    });

    const feedback = document.getElementById('feedback');
    if (isAnswered) {
        showFeedbackUI(q);
        document.getElementById('validate-btn').disabled = true;
    } else {
        feedback.style.display = 'none';
        feedback.className = 'feedback-box';
        document.getElementById('validate-btn').disabled = false;
    }

    document.getElementById('prev-btn').disabled = (index === 0);
    document.getElementById('next-btn').disabled = (index === displayedQuestions.length - 1);

    renderGrid();
}

function validateCurrent() {
    const q = displayedQuestions[currentIndex];
    const optContainer = document.getElementById('options-container');
    const checkboxes = optContainer.querySelectorAll('input[type="checkbox"]');
    const selected = [];
    checkboxes.forEach((cb, idx) => {
        if (cb.checked) selected.push(idx);
    });

    if (selected.length === 0) {
        alert("Veuillez sélectionner au moins une proposition.");
        return;
    }

    userAnswers[q.id] = selected;
    showFeedbackUI(q);
    document.getElementById('validate-btn').disabled = true;
    updateStats();
    renderGrid();
}

function showFeedbackUI(q) {
    const feedback = document.getElementById('feedback');
    const letters = ['A', 'B', 'C', 'D'];
    const sortedUser = [...(userAnswers[q.id] || [])].sort().join(',');
    const sortedCorr = [...q.correct].sort().join(',');
    const isCorrect = (sortedUser === sortedCorr);

    const corrLetters = q.correct.map(i => letters[i]).join(', ');

    feedback.style.display = 'block';
    if (isCorrect) {
        feedback.className = 'feedback-box correct';
        feedback.innerHTML = `<strong>Exact !</strong> (Réponse : ${corrLetters})<br>${q.rationale}`;
    } else {
        feedback.className = 'feedback-box incorrect';
        feedback.innerHTML = `<strong>Inexact ou incomplet.</strong> Bonne(s) réponse(s) : <strong>${corrLetters}</strong><br>${q.rationale}
        <div class="feynman-tip">💡 <strong>Astuce Feynman :</strong> Expliquez simplement pourquoi ${corrLetters} est la seule conduite ou donnée clinique exacte.</div>`;
    }
}

function prevQuestion() {
    if (currentIndex > 0) {
        currentIndex--;
        loadQuestion(currentIndex);
    }
}

function nextQuestion() {
    if (currentIndex < displayedQuestions.length - 1) {
        currentIndex++;
        loadQuestion(currentIndex);
    }
}

function updateStats() {
    const totalAnswered = Object.keys(userAnswers).length;
    let score = 0;
    questions.forEach(q => {
        if (userAnswers[q.id]) {
            const sortedUser = [...userAnswers[q.id]].sort().join(',');
            const sortedCorr = [...q.correct].sort().join(',');
            if (sortedUser === sortedCorr) score++;
        }
    });

    document.getElementById('progress-indicator').textContent = `Question ${currentIndex + 1} / ${displayedQuestions.length}`;
    document.getElementById('score-indicator').textContent = `Score : ${score} / ${totalAnswered} validées`;
}

function toggleFilterErrors() {
    const btn = document.getElementById('filter-btn');
    if (!reviewMode) {
        const errors = getErrorQuestions();
        if (errors.length === 0) {
            alert("Aucune erreur détectée pour le moment ! Continuez l'épreuve.");
            return;
        }
        reviewMode = true;
        displayedQuestions = errors;
        currentIndex = 0;
        btn.textContent = "Retour épreuve";
        btn.style.background = "var(--warning)";
    } else {
        reviewMode = false;
        displayedQuestions = [...questions];
        currentIndex = 0;
        btn.textContent = "Mode normal";
        btn.style.background = "var(--primary)";
    }
    loadQuestion(currentIndex);
    renderGrid();
}

function showResultsModal() {
    const modal = document.getElementById('results-modal');
    const circle = document.getElementById('modal-score-circle');
    const title = document.getElementById('modal-title');
    const text = document.getElementById('modal-feedback-text');

    const totalAnswered = Object.keys(userAnswers).length;
    let score = 0;
    questions.forEach(q => {
        if (userAnswers[q.id]) {
            const sortedUser = [...userAnswers[q.id]].sort().join(',');
            const sortedCorr = [...q.correct].sort().join(',');
            if (sortedUser === sortedCorr) score++;
        }
    });

    const percent = Math.round((score / questions.length) * 100);
    circle.textContent = `${score} / 40`;

    if (score >= 32) {
        circle.className = 'score-circle score-pass';
        title.textContent = "Validation Réussie (Niveau A)";
        text.textContent = `Félicitations ! Vous validez ${percent} % du CM5 Infections ORL et Respiratoires. Les critères de Mac Isaac, la conduite devant une OMA, la PFLA, la bronchiolite, la coqueluche et le Covid-19 sont parfaitement maîtrisés.`;
    } else {
        circle.className = 'score-circle score-fail';
        title.textContent = "Risque d'Ajournement (Niveau B/C)";
        text.textContent = `Score actuel : ${score}/40 (${percent} %). Des notions prioritaires (PAS d'AINS dans l'angine, critères antibiotiques de l'OMA, prise en charge de l'épiglottite ou choix des ATB respiratoires) doivent être impérativement consolidées.`;
    }

    modal.style.display = 'flex';
}

function closeResultsModal() {
    document.getElementById('results-modal').style.display = 'none';
}

function startErrorReview() {
    closeResultsModal();
    const errors = getErrorQuestions();
    if (errors.length === 0) {
        alert("Félicitations, vous n'avez aucune erreur à réviser !");
        return;
    }
    reviewMode = true;
    displayedQuestions = errors;
    currentIndex = 0;
    document.getElementById('filter-btn').textContent = "Retour épreuve";
    document.getElementById('filter-btn').style.background = "var(--warning)";
    loadQuestion(currentIndex);
    renderGrid();
}

function restartQuiz() {
    if (confirm("Voulez-vous réinitialiser toutes vos réponses et recommencer ?")) {
        userAnswers = {};
        reviewMode = false;
        displayedQuestions = [...questions];
        currentIndex = 0;
        document.getElementById('filter-btn').textContent = "Mode normal";
        document.getElementById('filter-btn').style.background = "var(--primary)";
        closeResultsModal();
        updateStats();
        loadQuestion(0);
        renderGrid();
    }
}

window.onload = init;
</script>
</body>
</html>
