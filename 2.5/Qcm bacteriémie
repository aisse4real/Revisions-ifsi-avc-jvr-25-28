  <script>
    // 40 QUESTIONS COMPLÈTES COUVRANT STRICTEMENT LE CM8
    // Contrainte : 1, 2 ou 3 réponses justes sans précision, distribution alternée des lettres A, B, C, D
    const quizData = [
      {
        id: 1,
        theme: "Bactériémies • Définitions",
        question: "Concernant les définitions fondamentales de la bactériémie et de la fongémie :",
        options: [
          { label: "A", text: "La bactériémie est définie par la présence d'une bactérie vivante dans le sang circulant, obligatoirement authentifiée par des hémocultures positives." },
          { label: "B", text: "Une fongémie correspond à la présence de champignons dans le sang circulant, authentifiée le plus souvent par des hémocultures fongiques positives à levures (Candida)." },
          { label: "C", text: "La bactériémie est une infection bénigne qui n'associe jamais de syndrome inflammatoire biologique (SIB)." },
          { label: "D", text: "Chez le patient hospitalisé, la fréquence d'une bactériémie est d'environ 1 %." }
        ],
        correct: ["A", "B", "D"],
        rationale: "A, B et D sont les définitions exactes du cours (diapos 2-3). C est faux : la bactériémie associe quasi constamment fièvre et syndrome inflammatoire biologique (SIB)."
      },
      {
        id: 2,
        theme: "SRIS, Sepsis & Choc",
        question: "Concernant le Syndrome de Réponse Inflammatoire Systémique (SRIS), le sepsis et le choc :",
        options: [
          { label: "A", text: "Le SRIS se définit par au moins 2 critères parmi : Température > 38,3 °C ou < 36 °C, FC > 90 bpm, FR > 20/min ou hyperventilation (PaCO2 < 32 mmHg), Leucocytes > 12 000 ou < 4 000/mm³." },
          { label: "B", text: "Le SRIS est toujours d'origine infectieuse et ne survient jamais lors d'une pancréatite aiguë, d'un choc ou d'une ischémie." },
          { label: "C", text: "La formule physiopathologique du sepsis est : Sepsis = SRIS + Infection." },
          { label: "D", text: "L'état de choc est une insuffisance circulatoire aiguë altérant de façon durable l'oxygénation et le métabolisme cellulaire tissulaire." }
        ],
        correct: ["A", "C", "D"],
        rationale: "A, C et D sont exacts (diapo 3). B est faux : le SRIS peut être provoqué par des agressions non infectieuses (pancréatite, brûlures, ischémie, choc cardiogénique, maladies systémiques)."
      },
      {
        id: 3,
        theme: "Épidémiologie des Bactériémies",
        question: "Quels sont les agents infectieux les plus fréquemment responsables de bactériémies communautaires selon les données épidémiologiques du cours ?",
        options: [
          { label: "A", text: "Staphylococcus aureus (et staphylocoques) pour environ 30 % des cas." },
          { label: "B", text: "Escherichia coli pour environ 30 % des cas." },
          { label: "C", text: "Les autres Bacilles à Gram Négatif (BGN) représentent 20 % des cas, et Streptococcus pneumoniae (pneumocoque) 10 %." },
          { label: "D", text: "Les virus respiratoires représentent plus de 50 % des causes de bactériémies." }
        ],
        correct: ["A", "B", "C"],
        rationale: "A, B et C sont conformes au camembert épidémiologique (diapo 5). D est aberrant : une bactériémie est par définition bactérienne (les virus ne provoquent pas de bactériémie)."
      },
      {
        id: 4,
        theme: "Portes d'entrée des Bactériémies",
        question: "À propos des portes d'entrée préférentielles des bactériémies (communautaires et associées aux soins) :",
        options: [
          { label: "A", text: "Les voies uro-génitales et les cathéters vasculaires représentent chacun environ 20 % des portes d'entrée." },
          { label: "B", text: "Les voies respiratoires et le tube digestif représentent chacun environ 15 % des cas." },
          { label: "C", text: "La porte d'entrée cutanée et la porte d'entrée osseuse représentent chacune environ 5 % des cas." },
          { label: "D", text: "La porte d'entrée reste inconnue dans moins de 0,1 % des cas." }
        ],
        correct: ["A", "B", "C"],
        rationale: "A, B et C sont exacts (diapo 6). D est faux : la porte d'entrée reste inconnue dans environ 10 % des bactériémies."
      },
      {
        id: 5,
        theme: "Corrélation Germes / Portes d'entrée",
        question: "Quelle corrélation entre germe isolé et porte d'entrée préférentielle à rechercher est conforme aux données du cours ?",
        options: [
          { label: "A", text: "Streptocoque oral ➔ Cavité buccale et soins dentaires." },
          { label: "B", text: "Streptococcus pneumoniae (pneumocoque) ➔ Poumon, méninges, sphère ORL." },
          { label: "C", text: "Staphylococcus aureus ou staphylocoque à coagulase négative ➔ Peau et cathéter vasculaire." },
          { label: "D", text: "Escherichia coli et entérocoques ➔ Exclusivement le parenchyme cérébral." }
        ],
        correct: ["A", "B", "C"],
        rationale: "A, B et C sont conformes au tableau 7. D est faux : E. coli et les entérocoques ont pour porte d'entrée les voies urinaires, le tube digestif, les voies biliaires ou un cathéter vasculaire."
      },
      {
        id: 6,
        theme: "Germes & Portes d'entrée (suite)",
        question: "Devant une bactériémie ou fongémie documentée, quelles recherches de foyers primitifs sont préconisées ?",
        options: [
          { label: "A", text: "Candida ➔ Rechercher une porte d'entrée sur le tube digestif ou un cathéter vasculaire." },
          { label: "B", text: "Bactéries anaérobies ➔ Rechercher une porte d'entrée au niveau du côlon ou du pelvis." },
          { label: "C", text: "Streptococcus pyogenes ➔ Rechercher en premier lieu une lésion cutanée (érysipèle, plaie)." },
          { label: "D", text: "La mise en évidence de Staphylococcus aureus impose d'arrêter immédiatement toute recherche de porte d'entrée." }
        ],
        correct: ["A", "B", "C"],
        rationale: "A, B et C sont exacts (diapo 7). D est une faute clinique majeure : l'isolement de S. aureus impose au contraire une traque impérative de la porte d'entrée (peau, cathéter) et des métastases septiques (endocardite, os)."
      },
      {
        id: 7,
        theme: "Conduite à Tenir Pratique",
        question: "Les 4 étapes hiérarchisées de la prise en charge immédiate d'une bactériémie suspectée sont :",
        options: [
          { label: "A", text: "1. Réaliser des hémocultures avant toute antibiothérapie." },
          { label: "B", text: "2. Évaluer les signes de gravité immédiats (sepsis, choc septique)." },
          { label: "C", text: "3. Rechercher la porte d'entrée et les localisations septiques secondaires métastatiques." },
          { label: "D", text: "4. Attendre au moins 72 heures les résultats définitifs de culture avant d'initier un antibiotique, même en cas de choc septique." }
        ],
        correct: ["A", "B", "C"],
        rationale: "A, B et C sont les 3 premières étapes clés (diapo 8). D est faux et mortel : le traitement antibiotique doit débuter dès les prélèvements réalisés sans tarder, en particulier en présence de signes de gravité."
      },
      {
        id: 8,
        theme: "Hémocultures • Phase Pré-analytique",
        question: "Quelles précautions strictes sont requises avant la réalisation d'un prélèvement d'hémoculture ?",
        options: [
          { label: "A", text: "Fermer la porte de la chambre du patient pour limiter l'aérobiocontamination ambiante." },
          { label: "B", text: "Vérifier la prescription médicale, les règles d'identitovigilance et préparer les bons de demande étiquetés." },
          { label: "C", text: "Vérifier la limpidité et la date de péremption des flacons aérobies et anaérobies." },
          { label: "D", text: "Porter un masque de type chirurgical et réaliser une friction des mains avec une Solution Hydro-Alcoolique (SHA)." }
        ],
        correct: ["A", "B", "C", "D"],
        rationale: "Les 4 propositions représentent les facteurs clés pré-analytiques d'une hémoculture de qualité (diapo 9)."
      },
      {
        id: 9,
        theme: "Hémocultures • Choix du Site",
        question: "Concernant le choix du site de ponction pour une hémoculture de qualité :",
        options: [
          { label: "A", text: "La ponction veineuse périphérique est la seule méthode validée en routine pour prélever le sang en vue de culture microbienne." },
          { label: "B", text: "Le prélèvement de sang via un Dispositif IntraVeineux (DIV) déjà en place doit être banni, même si le patient est difficile à piquer (risque majeur de faux positifs par contamination cutanée)." },
          { label: "C", text: "L'unique exception autorisant le prélèvement via un DIV est le diagnostic d'infection liée au cathéter par la méthode des hémocultures appariées." },
          { label: "D", text: "On privilégie toujours une ponction sur le bras hémiplégique ou du côté d'une fistule artério-veineuse." }
        ],
        correct: ["A", "B", "C"],
        rationale: "A, B et C sont exacts (diapo 10). D est une contre-indication formelle au site de ponction."
      },
      {
        id: 10,
        theme: "Hémocultures • Antisepsie",
        question: "Concernant l'antisepsie cutanée et la préparation du matériel d'hémoculture :",
        options: [
          { label: "A", text: "Désinfection de l'opercule en caoutchouc des flacons avec un antiseptique alcoolique (ex : Bétadine alcoolique 5 %) en laissant la compresse jusqu'au prélèvement." },
          { label: "B", text: "L'antisepsie cutanée large du site de ponction se fait en escargot ou de haut en bas sans jamais repasser sur la zone traitée." },
          { label: "C", text: "Après l'antisepsie cutanée et le séchage spontané, l'infirmier(ère) peut repalper la veine à main nue pour vérifier sa trajectoire." },
          { label: "D", text: "Chez l'adulte, la détersion puis la désinfection cutanée utilisent préférentiellement des antiseptiques alcooliques (chlorhexidine alcoolique ou Bétadine alcoolique)." }
        ],
        correct: ["A", "B", "D"],
        rationale: "A, B et D sont exacts (diapos 10-11). C est formellement interdit : après l'antisepsie cutanée, il ne faut plus jamais toucher la zone de ponction (risque d'inoculation de la flore résidente)."
      },
      {
